# Nobil API — register at nobil.no (free, may take 1-2 days for approval)
NOBIL_API_KEY=your_nobil_api_key_here

# Supabase — create a project at supabase.com (free, no card required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# No Mapbox token needed — MapLibre + OpenFreeMap + OSRM + Nominatim are all free and keyless
